---
const stack = [
  { area: "Backend", items: "Java, Spring Boot, microservices" },
  { area: "APIs", items: "REST, OpenAPI" },
  { area: "Data & tests", items: "Oracle Database, JUnit, Mockito" },
  { area: "Tooling", items: "Maven, Git, Jenkins" },
];
---

<section class="sec" id="about">
  <h2>About</h2>
  <div class="sec-body">
    <p>
      I'm a backend developer based in Granada, Spain. I like knowing what a feature is for before I build it, and I
      keep the person at the other end of the API in mind while I do.
    </p>
    <dl class="facts2">
      <div class="facts2-wide">
        <dt>Stack</dt>
        <dd>
          <div class="groups">
            {stack.map((g) => (
              <div>
                <span>{g.area}</span>
                {g.items}
              </div>
            ))}
          </div>
        </dd>
      </div>
      <div>
        <dt>Education</dt>
        <dd class="lines">
          <span>Higher Technician in Web Application Development</span>
          <span class="muted">I.E.S Zaidín-Vergeles · 2022–2024 · Grade 9/10</span>
        </dd>
      </div>
      <div>
        <dt>Languages</dt>
        <dd class="lines">
          <span>Spanish <span class="muted">· native</span></span>
          <span>English <span class="muted">· professional</span></span>
        </dd>
      </div>
    </dl>
  </div>
</section>
